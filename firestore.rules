rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: users
    // Document ID: {userId} (Firebase Auth UID)
    // Fields:
    //   - email: string (required)
    //   - name: string (required)
    //   - theme: string (required, enum: lime, blue, purple, dark)
    //
    // Collection: users/{userId}/tasks
    // Document ID: {taskId}
    // Fields:
    //   - title: string (required)
    //   - description: string (optional)
    //   - status: string (required, enum: todo, in_progress, done)
    //   - priority: string (required, enum: low, medium, high)
    //   - difficulty: string (required, enum: easy, medium, hard)
    //   - quadrant: string (required, enum: do_first, schedule, delegate, eliminate)
    //   - dueDate: string (optional)
    //   - estimatedMinutes: number (required)
    //   - actualMinutes: number (required)
    //   - createdAt: number (required)
    //   - completedAt: number (optional)
    //
    // Collection: users/{userId}/unavailabilities
    // Document ID: {unavailId}
    // Fields:
    //   - day: string (required)
    //   - startTime: string (required)
    //   - endTime: string (required)
    //   - reason: string (required)
    //
    // ===============================================================

    // Helper Functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() &&
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
          (request.auth.token.email == "reda.elhajji.43@gmail.com" && request.auth.token.email_verified == true));
    }

    function isValidUser(data) {
      return data.keys().hasOnly(['email', 'name', 'theme', 'role']) &&
             data.email is string && data.email.size() > 0 &&
             data.name is string && data.name.size() > 0 &&
             data.theme in ['midnight', 'cyberpunk', 'emerald', 'ocean', 'dracula', 'nord', 'volcano', 'sunset', 'forest', 'slate', 'rose', 'neon'] &&
             (!('role' in data) || data.role in ['admin', 'user']);
    }

    function isValidTask(data) {
      return data.keys().hasAll(['title', 'status', 'priority', 'difficulty', 'quadrant', 'estimatedMinutes', 'actualMinutes', 'createdAt']) &&
             data.title is string && data.title.size() > 0 && data.title.size() < 200 &&
             data.status in ['todo', 'in_progress', 'done'] &&
             data.priority in ['low', 'medium', 'high'] &&
             data.difficulty in ['easy', 'medium', 'hard'] &&
             data.quadrant in ['do_first', 'schedule', 'delegate', 'eliminate'] &&
             data.estimatedMinutes is number && data.estimatedMinutes >= 0 &&
             data.actualMinutes is number && data.actualMinutes >= 0 &&
             data.createdAt is number;
    }

    function isValidUnavailability(data) {
      return data.keys().hasAll(['day', 'startTime', 'endTime', 'reason']) &&
             data.day is string &&
             data.startTime is string &&
             data.endTime is string &&
             data.reason is string && data.reason.size() < 500;
    }

    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) && isValidUser(request.resource.data);
      allow update: if isOwner(userId) && isValidUser(request.resource.data);
      
      match /tasks/{taskId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && isValidTask(request.resource.data);
        allow update: if isOwner(userId) && isValidTask(request.resource.data);
        allow delete: if isOwner(userId);
      }
      
      match /unavailabilities/{unavailId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && isValidUnavailability(request.resource.data);
        allow update: if isOwner(userId) && isValidUnavailability(request.resource.data);
        allow delete: if isOwner(userId);
      }
    }
  }
}
